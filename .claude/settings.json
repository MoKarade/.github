{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/graphe.sh\" ] && bash \"$CLAUDE_PROJECT_DIR/scripts/graphe.sh\" session || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/graphe.sh\" ] && bash \"$CLAUDE_PROJECT_DIR/scripts/graphe.sh\" hook-guard search || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/scripts/graphe.sh\" ] && bash \"$CLAUDE_PROJECT_DIR/scripts/graphe.sh\" hook-guard read || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
